# ----------------------------------------------------------
# Python virtual environment
# ----------------------------------------------------------
# This folder contains all installed dependencies.
# It should not be committed to GitHub because it can be
# recreated using `pip install -r requirements.txt`.
venv/

# ----------------------------------------------------------
# Python compiled files
# ----------------------------------------------------------
# Python automatically generates these cached/compiled files.
# They are not needed in version control.
__pycache__/
*.pyc

# ----------------------------------------------------------
# Database and instance folder
# ----------------------------------------------------------
# Flask stores the SQLite database in the instance folder.
# The local database should not be committed because it
# contains developer-specific data.
instance/

# Explicitly ignore the SQLite DB in case it exists at root.
foodlink.db

# ----------------------------------------------------------
# Environment configuration files
# ----------------------------------------------------------
# If environment variables are stored in .env files,
# they should never be committed because they may contain secrets.
.env
.env.*
